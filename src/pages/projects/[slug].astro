---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects, courseColors } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const color = courseColors[project.course] ?? '#3b82f6';
const isVideo = (src: string) => src.endsWith('.mp4') || src.endsWith('.webm');
---

<Layout title={project.title} description={project.description}>
  <Nav />

  <main class="pt-24 pb-20 max-w-6xl mx-auto px-6">
    <!-- Back -->
    <div class="pt-10 pb-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-[#64748b] hover:text-[#94a3b8] transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver al portafolio
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <!-- Left: info -->
      <div class="lg:col-span-2 space-y-6">
        <div>
          <div
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium mb-4"
            style={`background: ${color}18; color: ${color}; border: 1px solid ${color}33;`}
          >
            {project.course}
          </div>
          <h1 class="text-3xl font-bold text-white mb-2">{project.title}</h1>
          <p class="text-sm text-[#475569] font-mono">{project.courseName}</p>
          {project.date && (
            <p class="text-xs text-[#475569] mt-1">{project.date}</p>
          )}
        </div>

        <div
          class="h-px"
          style="background: rgba(255,255,255,0.06);"
        >
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-widest text-[#475569] font-mono mb-3">Descripción</h2>
          <p class="text-[#94a3b8] leading-relaxed text-sm">{project.description}</p>
        </div>

        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-all duration-200 hover:scale-[1.02] hover:shadow-lg"
            style={`background: linear-gradient(135deg, ${color}cc, ${color}88);`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Ver en GitHub
          </a>
        )}

        <!-- Preview thumbnail on mobile -->
        <div class="lg:hidden">
          <img
            src={project.preview}
            alt={project.title}
            class="w-full rounded-xl object-cover"
            style="border: 1px solid rgba(255,255,255,0.08); max-height: 260px; object-position: top;"
          />
        </div>
      </div>

      <!-- Right: images -->
      <div class="lg:col-span-3 space-y-4">
        {
          project.images.length > 0 ? (
            project.images.map((img) => (
              <figure class="rounded-xl overflow-hidden" style="border: 1px solid rgba(255,255,255,0.07);">
                {isVideo(img.src) ? (
                  <video
                    src={img.src}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full"
                    style="max-height: 500px; object-fit: contain; background: #080810;"
                  />
                ) : (
                  <img
                    src={img.src}
                    alt={img.caption}
                    class="w-full object-cover"
                    style="max-height: 500px; object-fit: contain; background: #080810;"
                    loading="lazy"
                  />
                )}
                {img.caption && (
                  <figcaption class="px-4 py-2 text-xs text-[#475569] font-mono border-t" style="border-color: rgba(255,255,255,0.06);">
                    {img.caption}
                  </figcaption>
                )}
              </figure>
            ))
          ) : (
            <div class="hidden lg:block">
              <figure class="rounded-xl overflow-hidden" style="border: 1px solid rgba(255,255,255,0.07);">
                <img
                  src={project.preview}
                  alt={project.title}
                  class="w-full"
                  style="max-height: 440px; object-fit: cover; object-position: top;"
                />
              </figure>
            </div>
          )
        }
      </div>
    </div>
  </main>

  <footer
    class="border-t py-8 text-center text-sm text-[#475569]"
    style="border-color: rgba(255,255,255,0.06);"
  >
    <a
      href="https://github.com/ce-itcr"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 hover:text-[#94a3b8] transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      CE-ITCR en GitHub
    </a>
  </footer>
</Layout>
