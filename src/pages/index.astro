---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, allCourses, courseColors } from '../data/projects';
---

<Layout title="Portafolio">
  <Nav active="portfolio" />

  <main class="pt-24 pb-20">
    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-6 pt-16 pb-12">
      <div class="relative">
        <div
          class="absolute -top-20 -left-10 w-96 h-96 rounded-full blur-3xl opacity-10 pointer-events-none"
          style="background: radial-gradient(circle, #3b82f6, transparent);"
        >
        </div>
        <div
          class="absolute -top-10 right-0 w-72 h-72 rounded-full blur-3xl opacity-10 pointer-events-none"
          style="background: radial-gradient(circle, #8b5cf6, transparent);"
        >
        </div>

        <p class="text-sm font-mono text-[#3b82f6] mb-3 tracking-widest uppercase opacity-0 animate-[fadeUp_0.4s_ease_0.1s_forwards]">
          Instituto Tecnológico de Costa Rica
        </p>
        <h1
          class="text-5xl md:text-6xl font-bold text-white leading-tight mb-4 opacity-0 animate-[fadeUp_0.4s_ease_0.2s_forwards]"
        >
          Ingeniería en
          <span
            style="background: linear-gradient(135deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          >
            Computadores
          </span>
        </h1>
        <p
          class="text-[#94a3b8] text-lg max-w-2xl leading-relaxed opacity-0 animate-[fadeUp_0.4s_ease_0.3s_forwards]"
        >
          Colección de proyectos académicos desarrollados a lo largo de la carrera. Desde estructuras
          de datos hasta arquitectura de procesadores, inteligencia artificial y sistemas distribuidos.
        </p>

        <div
          class="flex flex-wrap gap-6 mt-8 opacity-0 animate-[fadeUp_0.4s_ease_0.4s_forwards]"
        >
          <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-white">{projects.length}</span>
            <span class="text-[#64748b] text-sm">proyectos</span>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-white">{allCourses.length}</span>
            <span class="text-[#64748b] text-sm">cursos</span>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-white">5+</span>
            <span class="text-[#64748b] text-sm">años</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="max-w-7xl mx-auto px-6 pb-8">
      <div class="flex flex-wrap gap-2" id="filter-bar">
        <button
          data-filter="all"
          class="filter-btn active px-4 py-1.5 rounded-full text-xs font-mono font-medium transition-all duration-200"
          style="background: rgba(255,255,255,0.1); color: #f1f5f9; border: 1px solid rgba(255,255,255,0.15);"
        >
          Todos
        </button>
        {
          allCourses.map((course) => (
            <button
              data-filter={course}
              class="filter-btn px-4 py-1.5 rounded-full text-xs font-mono font-medium transition-all duration-200"
              style={`color: ${courseColors[course]}; border: 1px solid ${courseColors[course]}33; background: ${courseColors[course]}11;`}
            >
              {course}
            </button>
          ))
        }
      </div>
    </section>

    <!-- Grid -->
    <section class="max-w-7xl mx-auto px-6">
      <div
        id="projects-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
      >
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>

      <div id="no-results" class="hidden text-center py-16 text-[#64748b]">
        <p class="text-lg">No hay proyectos para este filtro.</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer
    class="border-t py-8 text-center text-sm text-[#475569]"
    style="border-color: rgba(255,255,255,0.06);"
  >
    <a
      href="https://github.com/ce-itcr"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 hover:text-[#94a3b8] transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
      CE-ITCR en GitHub
    </a>
  </footer>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .filter-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
    color: #f1f5f9 !important;
  }

  .project-card.hidden-card {
    display: none;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-course]');
  const noResults = document.getElementById('no-results');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      let visible = 0;
      cards.forEach((card) => {
        const course = card.dataset.course ?? '';
        const show = filter === 'all' || course === filter;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0);
      }
    });
  });
</script>
