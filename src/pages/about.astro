---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { projects, allCourses, courseColors, courseNames } from '../data/projects';

const courseList = allCourses.map((code) => ({
  code,
  name: courseNames[code],
  color: courseColors[code],
  count: projects.filter((p) => p.course === code).length,
}));
---

<Layout title="Acerca de" description="Sobre el portafolio CE-ITCR — proyectos de Ingeniería en Computadores del TEC">
  <Nav active="about" />

  <main class="pt-24 pb-20 max-w-5xl mx-auto px-6">
    <!-- Header -->
    <section class="pt-16 pb-12">
      <p class="text-sm font-mono text-[#3b82f6] mb-3 tracking-widest uppercase">
        Acerca de
      </p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
        CE-ITCR
      </h1>
      <div class="flex gap-4 items-start">
        <div class="flex-1">
          <p class="text-[#94a3b8] text-lg leading-relaxed mb-4">
            Portafolio de proyectos desarrollados durante la carrera de <strong class="text-[#f1f5f9]">Ingeniería en Computadores</strong>
            en el <strong class="text-[#f1f5f9]">Instituto Tecnológico de Costa Rica</strong>.
          </p>
          <p class="text-[#94a3b8] leading-relaxed mb-6">
            Cada proyecto representa trabajo académico en áreas que van desde algoritmos y estructuras de datos
            hasta arquitectura de procesadores, sistemas operativos, redes, bases de datos e inteligencia artificial.
            El código fuente de todos los proyectos está disponible en GitHub.
          </p>
          <a
            href="https://github.com/ce-itcr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-all duration-200 hover:scale-[1.02]"
            style="background: linear-gradient(135deg, #3b82f6, #8b5cf6);"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Ver en GitHub
          </a>
        </div>
        <div class="hidden md:block flex-shrink-0">
          <img
            src="/img/imgavatar.jpeg"
            alt="CE-ITCR"
            class="w-48 h-48 rounded-2xl object-cover"
            style="border: 1px solid rgba(255,255,255,0.1);"
          />
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="mb-12">
      <div
        class="grid grid-cols-3 gap-4 p-6 rounded-2xl"
        style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);"
      >
        <div class="text-center">
          <div class="text-4xl font-bold text-white mb-1">{projects.length}</div>
          <div class="text-sm text-[#64748b]">Proyectos</div>
        </div>
        <div class="text-center" style="border-left: 1px solid rgba(255,255,255,0.07); border-right: 1px solid rgba(255,255,255,0.07);">
          <div class="text-4xl font-bold text-white mb-1">{allCourses.length}</div>
          <div class="text-sm text-[#64748b]">Cursos</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-white mb-1">5+</div>
          <div class="text-sm text-[#64748b]">Años</div>
        </div>
      </div>
    </section>

    <!-- Courses -->
    <section>
      <h2 class="text-xl font-semibold text-white mb-6">Cursos</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          courseList.map(({ code, name, color, count }) => (
            <div
              class="flex items-center gap-4 p-4 rounded-xl transition-colors duration-200 hover:bg-white/5"
              style="border: 1px solid rgba(255,255,255,0.06);"
            >
              <div
                class="w-10 h-10 rounded-lg flex-shrink-0 flex items-center justify-center text-xs font-mono font-bold"
                style={`background: ${color}18; color: ${color}; border: 1px solid ${color}33;`}
              >
                {code.slice(-2)}
              </div>
              <div class="min-w-0 flex-1">
                <div class="font-mono text-xs font-medium" style={`color: ${color};`}>
                  {code}
                </div>
                <div class="text-sm text-[#f1f5f9] leading-tight">{name}</div>
              </div>
              <div class="text-xs text-[#475569] flex-shrink-0">
                {count} {count === 1 ? 'proyecto' : 'proyectos'}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <footer
    class="border-t py-8 text-center text-sm text-[#475569]"
    style="border-color: rgba(255,255,255,0.06);"
  >
    <a
      href="https://github.com/ce-itcr"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 hover:text-[#94a3b8] transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      CE-ITCR en GitHub
    </a>
  </footer>
</Layout>
