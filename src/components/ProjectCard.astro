---
import type { Project } from '../data/projects';
import { courseColors } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const color = courseColors[project.course] ?? '#3b82f6';
---

<a
  href={`/projects/${project.slug}`}
  data-course={project.course}
  class="project-card group block rounded-xl overflow-hidden relative"
  style={`
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    animation: fadeUp 0.4s ease forwards;
    animation-delay: ${(index % 6) * 60}ms;
    opacity: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  `}
>
  <div class="relative overflow-hidden" style="aspect-ratio: 16/10;">
    <img
      src={project.preview}
      alt={project.title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      style={`background: linear-gradient(to top, rgba(13,13,20,0.9) 0%, transparent 60%);`}
    >
    </div>
    <div
      class="absolute top-3 left-3 px-2 py-1 rounded-md text-xs font-mono font-medium"
      style={`background: ${color}22; color: ${color}; border: 1px solid ${color}44;`}
    >
      {project.course}
    </div>
  </div>

  <div class="p-4">
    <h3 class="font-semibold text-[#f1f5f9] group-hover:text-white transition-colors text-sm leading-snug">
      {project.title}
    </h3>
    <p class="text-xs text-[#64748b] mt-1 font-mono">{project.courseName}</p>
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
    style={`background: ${color};`}
  >
  </div>
</a>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.12);
  }
</style>
